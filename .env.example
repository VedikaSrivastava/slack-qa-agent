# Required for the agent and Slack bot.
OPENAI_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Slack routing. This default allows conservative unmentioned follow-ups in threads
# established by an explicit mention.
SLACK_ROUTING_POLICY=agent_owned_thread_follow_ups

# Optional. Runtime tracing requires both LANGSMITH_TRACING=true and a LangSmith API key.
# The API key is also required by LangSmith sync, experiment, and augmentation commands.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
