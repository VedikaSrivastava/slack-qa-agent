# Required for the agent and Slack bot.
OPENAI_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional Slack routing override. When omitted, the application defaults to
# agent_owned_thread_follow_ups. Uncomment this stricter policy to require an
# explicit @mention on every turn, including follow-ups in an existing thread.
# SLACK_ROUTING_POLICY=explicit_mentions_only

# Optional local Langfuse observability. Create project keys in http://localhost:3000 after
# starting the observability profile, then place them here and restart the app.
# LANGFUSE_BASE_URL=http://langfuse-web:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
