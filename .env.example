APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=dev
PROMPT_VERSION=v1
RETRIEVAL_VERSION=v1

# Model
OPENAI_API_KEY=

# LangSmith tracing and experiments
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=slack-qa-agent

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Inngest local development
INNGEST_DEV=1
INNGEST_BASE_URL=http://inngest:8288
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Data and persistence
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://slack_qa:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/slack_qa
KNOWLEDGE_DB_PATH=/app/data/synthetic_startup.sqlite
